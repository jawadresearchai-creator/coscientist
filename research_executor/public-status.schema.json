{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-coscientist.local/schemas/public-status.schema.json",
  "title": "ResearchCoScientistPublicStatus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "task_type", "status", "privacy_class", "executor", "started_at", "completed_at", "deterministic_receipt", "run", "checks"],
  "properties": {
    "schema_version": {"const": "cosci.public-status/1.0"},
    "job_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,127}$"},
    "task_type": {"enum": ["SMOKE_TEST", "DATA_ACQUISITION", "ANALYSIS", "LITERATURE", "METHODOLOGY"]},
    "status": {"const": "SUCCEEDED"},
    "privacy_class": {"const": "PUBLIC_EXECUTOR_SAFE"},
    "executor": {"const": "GITHUB_ACTIONS_PUBLIC"},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "deterministic_receipt": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run": {"type": "object", "additionalProperties": false, "required": ["repository", "run_id", "run_attempt", "sha"], "properties": {"repository": {"type": ["string", "null"]}, "run_id": {"type": ["string", "null"]}, "run_attempt": {"type": ["string", "null"]}, "sha": {"type": ["string", "null"]}}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": {"name": {"type": "string"}, "status": {"const": "PASS"}}}}
  }
}
